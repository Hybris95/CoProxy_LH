<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoProxyApp.MainPage"
             Title="Conquer Proxy Configuration">

  <VerticalStackLayout Padding="20" Spacing="15">

    <Label Text="Login Port:"/>
    <Entry x:Name="LoginPortEntry" Keyboard="Numeric" Text="9958"/>

    <Label Text="Game Port:"/>
    <Entry x:Name="GamePortEntry" Keyboard="Numeric" Text="5816"/>

    <Label Text="Select Handler:"/>
    <Picker x:Name="HandlerPicker" />

    <Button Text="Start Proxy" Clicked="OnStartProxyClicked"/>

    <Label x:Name="StatusLabel" TextColor="Green" FontAttributes="Bold"/>

  </VerticalStackLayout>
</ContentPage>
